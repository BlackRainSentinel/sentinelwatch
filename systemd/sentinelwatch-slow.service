[Unit]
Description=SentinelWatch slow schedule (Tier 3 / Wordfence)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sentinelwatch
Group=sentinelwatch
WorkingDirectory=/opt/sentinelwatch
EnvironmentFile=-/opt/sentinelwatch/.env
Environment=SENTINELWATCH_CONFIG=/opt/sentinelwatch/config/config.yaml
ExecStart=/opt/sentinelwatch/.venv/bin/python -m sentinelwatch --schedule slow
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sentinelwatch/data

[Install]
WantedBy=multi-user.target
