[Unit]
Description=SentinelWatch Telegram command bot
After=network-online.target

[Service]
Type=simple
User=sentinelwatch
Group=sentinelwatch
WorkingDirectory=/opt/sentinelwatch
EnvironmentFile=-/opt/sentinelwatch/.env
Environment=SENTINELWATCH_CONFIG=/opt/sentinelwatch/config/config.yaml
ExecStart=/opt/sentinelwatch/.venv/bin/python -m sentinelwatch.bot
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sentinelwatch/data

[Install]
WantedBy=multi-user.target
