# Telegram (required for Telegram delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NVD API 2.0 (optional but recommended — raises rate limits)
NVD_API_KEY=

# GitHub (optional — higher rate limits for advisories API)
GITHUB_TOKEN=

# SMTP (required for email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
