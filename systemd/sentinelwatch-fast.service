[Unit]
Description=SentinelWatch fast schedule (Tier 1/2 collectors)
Documentation=https://github.com/BlackRainSentinel/sentinelwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sentinelwatch
Group=sentinelwatch
WorkingDirectory=/opt/sentinelwatch
EnvironmentFile=-/opt/sentinelwatch/.env
Environment=SENTINELWATCH_CONFIG=/opt/sentinelwatch/config/config.yaml
ExecStart=/opt/sentinelwatch/.venv/bin/python -m sentinelwatch --schedule fast
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sentinelwatch/data

[Install]
WantedBy=multi-user.target
